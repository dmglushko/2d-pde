{
  "format": "pde2d-app-case",
  "version": 1,
  "notes": "Heat flow u_t = k (u_xx + u_yy) in an annulus; the hole heats up from 0 towards 1. Solved in time with the implicit midpoint rule and conjugate gradients.",
  "geometry": {
    "source": "shape",
    "shape": "annulus",
    "options": {
      "outer_radius": 1,
      "inner_radius": 0.4
    },
    "region_edits": []
  },
  "mesh": {
    "spec": {
      "max_edge_length": {
        "absolute": null,
        "relative": 0.04
      }
    },
    "discretizer": {
      "type": "chord_length",
      "options": {
        "max_curve_deviation": {
          "absolute": null,
          "relative": 0.002
        },
        "corner_angle_degrees": 30
      }
    },
    "triangulator": {
      "type": "cdt",
      "options": {}
    },
    "refiner": {
      "type": "ruppert",
      "options": {
        "min_angle_degrees": 25,
        "max_points": 10000000
      }
    },
    "improvers": []
  },
  "problem": {
    "equation": {
      "text": "u_t - div(k*grad(u)) = 0"
    },
    "parameters": {
      "k": 0.1
    },
    "boundary_conditions": {
      "outer": {
        "text": "u = 0"
      },
      "inner": {
        "text": "u = 1 - exp(-t)"
      }
    },
    "initial": {
      "u": "0"
    }
  },
  "assembly": {
    "t": 0.0
  },
  "solve": {
    "mode": "time",
    "linear_solver": {
      "type": "conjugate_gradient",
      "options": {
        "tolerance": 1e-10,
        "max_iterations": 1000
      }
    },
    "static": {
      "t": 0.0
    },
    "time": {
      "t0": 0.0,
      "t1": 5.0,
      "snapshots": 50,
      "method": {
        "type": "implicit_midpoint",
        "options": {}
      },
      "step": {
        "type": "fixed_step",
        "options": {
          "dt": 0.05
        }
      }
    }
  }
}
